generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  passwordHash      String
  role              Role      @default(CREATOR)
  isActive          Boolean   @default(true)
  failedLoginAttempts Int     @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  invitesSent       InviteToken[] @relation("InvitedBy")
}

enum Role {
  ADMIN
  CREATOR
}

model InviteToken {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique @default(cuid())
  expiresAt   DateTime
  usedAt      DateTime?
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  @@index([token])
  @@index([email])
}

model Source {
  id          String       @id @default(cuid())
  type        SourceType
  title       String
  senderEmail String?
  senderName  String?
  receivedAt  DateTime
  rawContent  String
  plainText   String
  summary     String?
  metadata    Json?
  status      SourceStatus @default(NEW)
  filePath    String?
  messageId   String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  scripts     PodcastScriptSource[]
}

enum SourceType {
  NEWSLETTER
  PDF_UPLOAD
  MANUAL_TEXT
}

enum SourceStatus {
  NEW
  PROCESSING
  READY
  USED
  ARCHIVED
}

model PodcastScript {
  id           String              @id @default(cuid())
  title        String
  content      String
  version      Int                 @default(1)
  parentId     String?
  status       ScriptStatus        @default(DRAFT)
  feedback     ScriptFeedback[]
  config       Json?
  modelUsed    String?
  promptTokens Int?
  outputTokens Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sources       PodcastScriptSource[]
  audioVersions PodcastAudio[]
}

model PodcastScriptSource {
  scriptId String
  sourceId String
  script   PodcastScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  source   Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@id([scriptId, sourceId])
}

model ScriptFeedback {
  id        String        @id @default(cuid())
  scriptId  String
  script    PodcastScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())
}

enum ScriptStatus {
  GENERATING
  DRAFT
  REVISING
  APPROVED
  AUDIO_PENDING
  COMPLETED
}

model PodcastAudio {
  id           String       @id @default(cuid())
  scriptId     String
  script       PodcastScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  filePath     String
  fileName     String
  fileSize     Int
  duration     Int
  voiceAlexId  String
  voiceKimId   String
  modelId      String
  status       AudioStatus  @default(PROCESSING)
  errorMessage String?
  createdAt    DateTime     @default(now())
  episode      PodcastEpisode?
}

enum AudioStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model PodcastEpisode {
  id            String        @id @default(cuid())
  audioId       String        @unique
  audio         PodcastAudio  @relation(fields: [audioId], references: [id], onDelete: Cascade)
  title         String
  description   String
  episodeNumber Int
  publishedAt   DateTime?
  status        EpisodeStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum EpisodeStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model PodcastFeedConfig {
  id          String   @id @default(cuid())
  title       String   @default("PodBrief")
  description String   @default("Täglicher Newsletter-Podcast über digitale Verwaltung")
  author      String   @default("PodBrief")
  language    String   @default("de")
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FeedSubscriber {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  personalToken String        @unique @default(cuid())
  isActive      Boolean       @default(true)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accessLogs    FeedAccessLog[]
}

model FeedAccessLog {
  id           String         @id @default(cuid())
  subscriberId String
  subscriber   FeedSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  ipAddress    String
  userAgent    String?
  endpoint     String
  resourceId   String?
  createdAt    DateTime       @default(now())
  @@index([subscriberId, createdAt])
  @@index([ipAddress, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
