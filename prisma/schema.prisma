generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  passwordHash        String
  role                Role      @default(CREATOR)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  inboxAlias          String?   @unique
  apiTokenHash        String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  invitesSent         InviteToken[]       @relation("InvitedBy")
  sources             Source[]
  scripts             PodcastScript[]
  audioFiles          PodcastAudio[]
  episodes            PodcastEpisode[]
  automationRules     AutomationRule[]
}

enum Role {
  ADMIN
  CREATOR
}

model InviteToken {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique @default(cuid())
  expiresAt   DateTime
  usedAt      DateTime?
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  @@index([token])
  @@index([email])
}

model Source {
  id          String       @id @default(cuid())
  type        SourceType
  title       String
  senderEmail String?
  senderName  String?
  receivedAt  DateTime
  rawContent  String
  plainText   String
  summary     String?
  metadata    Json?
  status      SourceStatus @default(NEW)
  filePath    String?
  messageId   String?      @unique
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  scripts     PodcastScriptSource[]
  embeddings  SourceEmbedding[]
}

enum SourceType {
  NEWSLETTER
  PDF_UPLOAD
  MANUAL_TEXT
}

enum SourceStatus {
  NEW
  PROCESSING
  READY
  USED
  ARCHIVED
}

model SourceEmbedding {
  id        String   @id @default(cuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunk     String
  chunkIndex Int     @default(0)
  model     String   @default("text-embedding-3-small")
  createdAt DateTime @default(now())
  // The actual vector column is added via raw SQL migration (pgvector)
  // We use $queryRaw for vector operations
  @@index([sourceId])
}

model PodcastScript {
  id           String              @id @default(cuid())
  title        String
  content      String
  version      Int                 @default(1)
  parentId     String?
  status       ScriptStatus        @default(DRAFT)
  feedback     ScriptFeedback[]
  config       Json?
  modelUsed    String?
  promptTokens Int?
  outputTokens Int?
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sources       PodcastScriptSource[]
  audioVersions PodcastAudio[]
}

model PodcastScriptSource {
  scriptId String
  sourceId String
  script   PodcastScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  source   Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@id([scriptId, sourceId])
}

model ScriptFeedback {
  id        String        @id @default(cuid())
  scriptId  String
  script    PodcastScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())
}

enum ScriptStatus {
  GENERATING
  DRAFT
  REVISING
  APPROVED
  AUDIO_PENDING
  COMPLETED
}

model PodcastAudio {
  id           String       @id @default(cuid())
  scriptId     String
  script       PodcastScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  filePath     String
  fileName     String
  fileSize     Int
  duration     Int
  voiceAlexId  String
  voiceKimId   String
  modelId      String
  status       AudioStatus  @default(PROCESSING)
  errorMessage String?
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  episode      PodcastEpisode?
}

enum AudioStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model PodcastEpisode {
  id            String        @id @default(cuid())
  audioId       String        @unique
  audio         PodcastAudio  @relation(fields: [audioId], references: [id], onDelete: Cascade)
  title         String
  description   String
  episodeNumber Int
  publishedAt   DateTime?
  status        EpisodeStatus @default(DRAFT)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum EpisodeStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model AutomationRule {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  isActive    Boolean  @default(true)
  schedule    String   // cron expression
  sourceFilter Json?   // { senders: string[], types: string[] }
  topicFilter  String? // semantic search query
  speakers    Int      @default(2)
  duration    Int      @default(10)
  autoPublish Boolean  @default(false)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
  @@index([isActive])
}

model PodcastFeedConfig {
  id          String   @id @default(cuid())
  title       String   @default("PodBrief")
  description String   @default("Täglicher Newsletter-Podcast über digitale Verwaltung")
  author      String   @default("PodBrief")
  language    String   @default("de")
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FeedSubscriber {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  personalToken String        @unique @default(cuid())
  isActive      Boolean       @default(true)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accessLogs    FeedAccessLog[]
}

model FeedAccessLog {
  id           String         @id @default(cuid())
  subscriberId String
  subscriber   FeedSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  ipAddress    String
  userAgent    String?
  endpoint     String
  resourceId   String?
  createdAt    DateTime       @default(now())
  @@index([subscriberId, createdAt])
  @@index([ipAddress, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
